# Copy to `.env` in the project directory (or set ANIVAULT_DOTENV_PATH).
# TMDB: https://developer.themoviedb.org/docs/getting-started
TMDB_API_KEY=

# Cursor MCP — Google Developer Knowledge (optional): https://developers.google.com/knowledge/mcp
GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY=

# Optional: absolute path to `.env` if the app is not started from the project root.
# ANIVAULT_DOTENV_PATH=

# --- Cursor MCP (see `.cursor/mcp.json`; tokens are not loaded from `.env` automatically) ---
# GitHub MCP — https://github.com/settings/tokens (repo scope as needed)
GITHUB_PERSONAL_ACCESS_TOKEN=
# Supabase MCP — dashboard → Account → Access tokens; replace YOUR_SUPABASE_PROJECT_REF in `.cursor/mcp.json`
SUPABASE_ACCESS_TOKEN=
# Context7 — optional, higher limits: https://context7.com/dashboard
CONTEXT7_API_KEY=
